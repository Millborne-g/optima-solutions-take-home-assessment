# HubSpot Private App access token (server-only — never expose to the browser)
# Create a Private App at: HubSpot portal → Settings → Integrations → Private Apps
# Required scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
#   crm.objects.deals.read
#   crm.objects.deals.write
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token_here

# HubSpot Deal pipeline and stage IDs (portal-specific; server-only)
# Find at: Settings → Objects → Deals → Pipelines
HUBSPOT_DEAL_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=appointmentscheduled

# Shared secret for HMAC-SHA256 webhook verification (server-only)
# Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here

# Optional: override mock sender target URL
# WEBHOOK_URL=http://localhost:3000/api/webhooks/order

# Supabase project URL (safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for client-side use, limited by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service-role key (server-only — NEVER expose to the browser)
# Found at: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
